ANALYSIS_MODE=mock
GEMINI_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODELS=
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=
SEARCH_EXTRA_DOMAINS=
CACHE_TTL_SECONDS=900
DART_API_KEY=
# 영어 검색어를 함께 검색(외신 확인용). off 로 끄면 LLM 호출이 1회 줄어듭니다.
ENGLISH_SEARCH=on
# 정정·논란 등 후속 보도 검색. off로 끄면 해당 Tavily 검색 1회가 줄어듭니다.
FOLLOWUP_SEARCH=on
