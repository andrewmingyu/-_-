{
  "manifest_version": 3,
  "name": "뉴스체크 AI",
  "short_name": "뉴스체크",
  "version": "0.1.0",
  "description": "뉴스 기사를 읽는 자리에서 제목 자극도, 기자·언론사 특징, 관련 기사 교차검증을 바로 보여줍니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "뉴스체크 AI로 이 기사 분석하기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"]
}
