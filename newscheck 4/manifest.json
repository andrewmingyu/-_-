{
  "manifest_version": 3,
  "name": "뉴스체크 AI",
  "short_name": "뉴스체크",
  "version": "0.2.0",
  "description": "기사의 근거와 원출처를 추적하고 확인 가능한 출처 정보와 주의사항을 제공합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "뉴스체크 AI로 이 기사 분석하기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://news.naver.com/*",
    "https://n.news.naver.com/*",
    "https://m.news.naver.com/*",
    "https://entertain.naver.com/*",
    "https://m.entertain.naver.com/*",
    "https://sports.naver.com/*",
    "https://m.sports.naver.com/*",
    "https://*/*",
    "http://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/extract.js",
        "shared/article.js",
        "shared/view.js",
        "shared/summary.js",
        "shared/selection.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
